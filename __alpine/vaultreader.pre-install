#!/usr/bin/env ash

# Ensure group 'vread' exists (prefer GID 2500 if free). No user creation.
set -e

group_name="devops"
desired_gid=2500

if ! getent group "${group_name}" >/dev/null 2>&1; then
    if getent group "${desired_gid}" >/dev/null 2>&1; then
        addgroup -S "${group_name}"
    else
        addgroup -S -g "${desired_gid}" "${group_name}"
    fi
fi

exit 0
